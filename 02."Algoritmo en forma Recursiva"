#include <iostream>
using namespace std;

double evaluar(double coef[], int i, int N, double x) {
    if (i == N) {
        return coef[i];
    }

    return coef[i] + x * evaluar(coef, i + 1, N, x);
}

int main() {
    int N;
    double x;

    cout << "Ingrese el grado del polinomio: ";
    cin >> N;

    double coef[N + 1];

    cout << "Ingrese los coeficientes ;"<<endl;

    for (int i = 0; i <= N; i++) {
        cin >> coef[i];
    }

    cout << "Ingrese el valor de x: ";
    cin >> x;

    double resultado = evaluar(coef, 0, N, x);

    cout << "P(" << x << ") = " << resultado << endl;

    return 0;
}
