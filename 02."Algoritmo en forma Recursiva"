#include <iostream>
using namespace std;

double potencia(double x, int y) {
    double t;

    if (y == 0) {
        return 1;
    }

    if (y % 2 == 1) {
        return x * potencia(x, y - 1);
    } else {
        t = potencia(x, y / 2);
        return t * t;
    }
}

int main() {
    double x;
    int y;

    cout << "Ingrese la base x: ";
    cin >> x;

    cout << "Ingrese el exponente y: ";
    cin >> y;

    cout << x << "^" << y << " = " << potencia(x, y) << endl;

    return 0;
}
