#include <stdio.h>

void quickSort(int A[], int inicio, int fin) {
    int i, j, pivote, aux;

    if (inicio >= fin) {
        return;
    }

    pivote = A[fin];
    i = inicio - 1;

    for (j = inicio; j < fin; j++) {
        if (A[j] < pivote) {
            i++;

            aux = A[i];
            A[i] = A[j];
            A[j] = aux;
        }
    }

    aux = A[i + 1];
    A[i + 1] = A[fin];
    A[fin] = aux;

    pivote = i + 1;

    quickSort(A, inicio, pivote - 1);
    quickSort(A, pivote + 1, fin);
}

int main() {
    int lista[] = {4, 2, 9, 1, 5, 3};
    int N = sizeof(lista) / sizeof(lista[0]);

    quickSort(lista, 0, N - 1);

    printf("Ordenado: ");

    for (int i = 0; i < N; i++) {
        printf("%d ", lista[i]);
    }

    printf("\n");

    return 0;
}
