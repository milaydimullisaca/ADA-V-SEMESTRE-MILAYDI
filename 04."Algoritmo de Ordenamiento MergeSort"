#include <stdio.h>

void mergeSort(int A[], int inicio, int fin) {
    int i, j, k, medio, aux[100];

    if (inicio < fin) {
        medio = (inicio + fin) / 2;

        mergeSort(A, inicio, medio);
        mergeSort(A, medio + 1, fin);

        i = inicio;
        j = medio + 1;
        k = inicio;

        while (i <= medio && j <= fin) {
            if (A[i] < A[j]) {
                aux[k] = A[i];
                i++;
            } else {
                aux[k] = A[j];
                j++;
            }
            k++;
        }

        while (i <= medio) {
            aux[k] = A[i];
            i++;
            k++;
        }

        while (j <= fin) {
            aux[k] = A[j];
            j++;
            k++;
        }

        for (i = inicio; i <= fin; i++) {
            A[i] = aux[i];
        }
    }
}

int main() {
    int lista[] = {38, 27, 43, 3, 9, 82, 10};
    int N = sizeof(lista) / sizeof(lista[0]);

    mergeSort(lista, 0, N - 1);

    printf("Ordenado: ");

    for (int i = 0; i < N; i++) {
        printf("%d ", lista[i]);
    }

    return 0;
}
