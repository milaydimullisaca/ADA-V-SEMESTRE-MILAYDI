#include <stdio.h>

void merge(int arr[], int inicio, int medio, int fin) {
    int i = inicio;
    int j = medio + 1;
    int k = 0;

    int temp[fin - inicio + 1];

    while (i <= medio && j <= fin) {
        if (arr[i] <= arr[j]) {
            temp[k] = arr[i];
            i++;
        } else {
            temp[k] = arr[j];
            j++;
        }
        k++;
    }

    while (i <= medio) {
        temp[k] = arr[i];
        i++;
        k++;
    }

    while (j <= fin) {
        temp[k] = arr[j];
        j++;
        k++;
    }

    for (i = inicio, k = 0; i <= fin; i++, k++) {
        arr[i] = temp[k];
    }
}

void mergeSort(int arr[], int inicio, int fin) {
    if (inicio >= fin) {
        return;
    }

    int medio = (inicio + fin) / 2;

    mergeSort(arr, inicio, medio);
    mergeSort(arr, medio + 1, fin);

    merge(arr, inicio, medio, fin);
}

int main() {
    int arr[] = {38, 27, 43, 3, 9, 82, 10};
    int N = sizeof(arr) / sizeof(arr[0]);

    printf("Antes: ");

    for (int i = 0; i < N; i++) {
        printf("%d ", arr[i]);
    }

    mergeSort(arr, 0, N - 1);

    printf("\nOrdenado: ");

    for (int i = 0; i < N; i++) {
        printf("%d ", arr[i]);
    }

    printf("\n");

    return 0;
}
