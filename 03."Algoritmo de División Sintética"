#include <iostream>
using namespace std;

double divisionSintetica(double coef[], int N, double x) {
    double resultado = coef[0];

    for (int i = 1; i <= N; i++) {
        resultado = resultado * x + coef[i];
    }

    return resultado;
}

int main() {
    int N;
    double x;

    cout << "Ingrese el grado del polinomio: ";
    cin >> N;

    double coef[N + 1];

    cout << "Ingrese los coeficientes" << endl;

    for (int i = 0; i <= N; i++) {
        cin >> coef[i];
    }

    cout << "Ingrese el valor de x: ";
    cin >> x;

    cout << "P(" << x << ") = "
         << divisionSintetica(coef, N, x) << endl;

    return 0;
}
