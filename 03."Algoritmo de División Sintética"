#include <stdio.h>

double divisionSintetica(double coef[], int N, double x) {
    double resultado = coef[0];

    for (int i = 1; i <= N; i++) {
        resultado = resultado * x + coef[i];
    }

    return resultado;
}

int main() {
    int N;
    double x;

    printf("Ingrese el grado del polinomio: ");
    scanf("%d", &N);

    double coef[N + 1];

    printf("Ingrese los coeficientes:\n");

    for (int i = 0; i <= N; i++) {
        scanf("%lf", &coef[i]);
    }

    printf("Ingrese el valor de x: ");
    scanf("%lf", &x);

    printf("P(%.2f) = %.2f\n", x, divisionSintetica(coef, N, x));

    return 0;
}
