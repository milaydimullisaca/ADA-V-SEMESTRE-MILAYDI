#include <stdio.h>

double evaluar(double coef[], int N, double x) {
    double resultado = 0;
    double potencia = 1;

    for (int i = N; i >= 0; i--) {
        resultado = resultado + coef[i] * potencia;
        potencia = potencia * x;
    }

    return resultado;
}

int main() {
    int N;
    double x;

    printf("Ingrese el grado del polinomio: ");
    scanf("%d", &N);

    double coef[N + 1];

    printf("Ingrese los coeficientes:\n");

    for (int i = 0; i <= N; i++) {
        scanf("%lf", &coef[i]);
    }

    printf("Ingrese el valor de x: ");
    scanf("%lf", &x);

    printf("P(%.2f) = %.2f\n", x, evaluar(coef, N, x));

    return 0;
}
